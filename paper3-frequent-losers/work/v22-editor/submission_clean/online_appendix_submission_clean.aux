\@writefile{lof}{\contentsline {figure}{\numberline {C.1}{\ignorespaces Over-crediting bias $\Delta = \mathrm  {AUC}_{\text  {raw}} - \mathrm  {AUC}_{\text  {opp-adj}}$ over the volume-dispersion $\times $ base-rate grid. This is a \emph  {synthetic surface anchored at one empirical point per platform}, not an estimated inflation curve: the backbone is simulated from a Gamma family, calibrated once so the BEC coordinate reproduces its observed raw area, and the two real platform points are then \emph  {overlaid} at their measured $(\mathrm  {CV}(T),\text  {base rate})$ coordinates---BEC ($\mathrm  {CV}=2.79$, base rate $3.9\%$) and federal ComprasNet ($\mathrm  {CV}=3.79$, base rate $0.5\%$). The surface increases in $\mathrm  {CV}(T)$ and decreases in the adjudicated base rate, as Proposition~\ref {prop:inflation} predicts; federal sits in a higher-$\Delta $ region because higher dispersion and a roughly seven-fold lower base rate both push toward more complete inflation. Only $\mathrm  {CV}(T)$ and the base rate are taken from data.}}{15}{figure.caption.9}\protected@file@percent }
\newlabel{fig:inflation_surface}{{C.1}{15}{Over-crediting bias $\Delta = \mathrm {AUC}_{\text {raw}} - \mathrm {AUC}_{\text {opp-adj}}$ over the volume-dispersion $\times $ base-rate grid. This is a \emph {synthetic surface anchored at one empirical point per platform}, not an estimated inflation curve: the backbone is simulated from a Gamma family, calibrated once so the BEC coordinate reproduces its observed raw area, and the two real platform points are then \emph {overlaid} at their measured $(\mathrm {CV}(T),\text {base rate})$ coordinates---BEC ($\mathrm {CV}=2.79$, base rate $3.9\%$) and federal ComprasNet ($\mathrm {CV}=3.79$, base rate $0.5\%$). The surface increases in $\mathrm {CV}(T)$ and decreases in the adjudicated base rate, as Proposition~\ref {prop:inflation} predicts; federal sits in a higher-$\Delta $ region because higher dispersion and a roughly seven-fold lower base rate both push toward more complete inflation. Only $\mathrm {CV}(T)$ and the base rate are taken from data}{figure.caption.9}{}}
