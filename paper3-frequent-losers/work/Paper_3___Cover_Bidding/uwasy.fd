%% Local override of uwasy.fd to suppress bold-substitution warnings.
%% Original: wasysym 2020/01/19 v2.4
\ProvidesFile{uwasy.fd}%
             [2020/01/19 v2.4
              Wasy-2 symbol font definitions (local ssub fix)]
\DeclareFontFamily{U}{wasy}{}
\DeclareFontShape{U}{wasy}{m}{n}{%
<5>
<6>
<7>
<8>
<9> gen * wasy
<10> <10.95> <12> <14.4> <17.28> <20.74> <24.88> wasy10  }{}
\DeclareFontShape{U}{wasy}{b}{n}{ <-10> ssub * wasy/m/n
 <10> <10.95> <12> <14.4> <17.28> <20.74> <24.88> wasyb10 }{}
\DeclareFontShape{U}{wasy}{bx}{n}{ <-> ssub * wasy/b/n}{}
\DeclareFontShape{U}{wasy}{m}{sl}{ <-> wasysl10 }{}
\DeclareFontShape{U}{wasy}{m}{it}{ <-> ssub * wasy/m/sl }{}
\endinput
