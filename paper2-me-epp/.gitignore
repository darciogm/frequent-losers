# Paper 2 (ME/EPP) — ignore build artifacts and OS/tool metadata.
# Binary/data types (*.pdf, *.csv, *.dta, site/, .claude/) are already
# covered by the repo-root .gitignore; this file adds the dev cruft that
# kept reappearing after each LaTeX build, R session, or Windows download.

# R session state
.Rhistory
.RData
.Rapp.history

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.out
*.toc
*.lof
*.lot
*.spl
*.fls
*.fdb_latexmk
*.synctex.gz
*.bcf
*.run.xml
*.nav
*.snm
*.vrb

# Windows alternate-data-stream metadata (from downloads / Outlook)
*:Zone.Identifier
*:OECustomProperty

# Node / Remotion video build trees
node_modules/
**/video-remotion/build/
**/video-remotion/public/
