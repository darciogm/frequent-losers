# Python virtualenv (1.3 GB)
.venv/
.venv-gnn/

# DATASUS raw + derivados grandes (gigabytes) ficam fora do git
02_data/raw/**
02_data/intermediate/**
02_data/final/**

# Mas as caches do NLP (BrasilAPI + Anthropic) vão junto com o repo
# para reproduzir as classificações sem re-bater os endpoints.
!02_data/intermediate/cnpj_cache.sqlite
!02_data/intermediate/llm_classify_cache.sqlite
!02_data/intermediate/llm_classify_cache_v2.sqlite

# E os snippets do WebSearch (R1) idem — pequenos JSONs por CNES
!02_data/intermediate/web_snippets/
!02_data/intermediate/web_snippets/*.json

# logs e scratch
04_logs/**
06_scratch/**

# LaTeX intermediates
01_manuscript/*.aux
01_manuscript/*.log
01_manuscript/*.out
01_manuscript/*.bbl
01_manuscript/*.blg
01_manuscript/*.toc
01_manuscript/*.synctex.gz
01_manuscript/*.fls
01_manuscript/*.fdb_latexmk

# Python misc
__pycache__/
*.pyc
.ipynb_checkpoints/
.env
.DS_Store

# Figuras: por default ignorar PDF/PNG no monorepo, mas permitir as figuras finais
# do paper (necessárias para compilar main.tex)
!04_figures/fig_*.pdf
!04_figures/fig_*.png

# main.pdf é build artifact mas comitamos para reviewers acessarem o PDF
!01_manuscript/main.pdf
.venv/
data/cache_osm/
