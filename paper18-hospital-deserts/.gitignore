# Python virtualenv (1.3 GB)
.venv/

# DATASUS raw + derivados grandes (gigabytes)
02_data/raw/**
02_data/intermediate/**
02_data/final/**

# logs e scratch
04_logs/**
06_scratch/**

# LaTeX intermediates
01_manuscript/*.aux
01_manuscript/*.log
01_manuscript/*.out
01_manuscript/*.bbl
01_manuscript/*.blg
01_manuscript/*.toc
01_manuscript/*.synctex.gz
01_manuscript/*.fls
